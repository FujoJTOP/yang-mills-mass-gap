module costest2
choose runtime

use "stdlib/f64.lomt"
use "stdlib/mathf.lomt"
use "stdlib/mem.lomt"
use "stdlib/f64fmt.lomt"

fn main() {
    let out: ptr = alloc(64);
    let sc: ptr = alloc(f64fmt_scratch_bytes());
    let qp: ptr = alloc(8);
    let vals: [u64; 7] = [0x0000000000000000, 0x3FE0000000000000, 0x3FF0000000000000, 0x4000000000000000, 0x4008000000000000, 0xBFE0000000000000, 0xC000000000000000];
    let i: u32 = 0;
    while i < 7 {
        let n: u32 = f64fmt_fixed(out, 0, mathf_cos_scr(vals[i], qp), 6, sc);
        syscall4(1, 1, out as u64, n as u64);
        print("\n");
        i = i + 1;
    }
}
