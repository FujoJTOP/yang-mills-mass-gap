module u1
choose runtime

use "stdlib/f64.lomt"
use "stdlib/f64conv.lomt"
use "stdlib/mathf.lomt"
use "stdlib/rand.lomt"
use "stdlib/mem.lomt"
use "stdlib/f64fmt.lomt"

const L: u32 = 24;
const NN: u32 = 576;
const NV: u32 = 1152;
const THERM: u32 = 200;
const MEAS: u32 = 400;
const STRIDE: u32 = 4;
const NLOOP: u32 = 16;

const ONE: u64 = 0x3FF0000000000000;
const ZERO: u64 = 0x0000000000000000;
const PI: u64 = 0x400921FB54442D18;
const TWO_PI: u64 = 0x401921FB54442D18;
const NEG_PI: u64 = 0xC00921FB54442D18;
const DELTA: u64 = 0x3FE0000000000000;

fn up(x: u32) -> u32 {
    if x + 1 >= L { return 0; }
    return x + 1;
}

fn dn(x: u32) -> u32 {
    if x == 0 { return L - 1; }
    return x - 1;
}

fn lget(p: ptr, mu: u32, x0: u32, x1: u32) -> u64 {
    return mem_load64(p, (mu * NN + x0 * L + x1) * 8);
}

fn lset(p: ptr, mu: u32, x0: u32, x1: u32, v: u64) {
    mem_store64(p, (mu * NN + x0 * L + x1) * 8, v);
}

fn wrap(x: u64) -> u64 {
    if f64_gt(x, PI) { return f64_sub(x, TWO_PI); }
    if f64_lt(x, NEG_PI) { return f64_add(x, TWO_PI); }
    return x;
}

fn uniform01(sp: ptr) -> u64 {
    let s: u64 = mem_load64(sp, 0);
    let r: u64 = rand_next(s);
    mem_store64(sp, 0, r);
    let bits: u64 = 0x3FF0000000000000 | (r >> 12);
    return f64_sub(bits, ONE);
}

fn plaqA(mu: u32, x0: u32, x1: u32, p: ptr) -> u64 {
    if mu == 0 {
        let a: u64 = lget(p, 1, up(x0), x1);
        let b: u64 = lget(p, 0, x0, up(x1));
        let c: u64 = lget(p, 1, x0, x1);
        return f64_sub(f64_sub(a, b), c);
    }
    let a: u64 = lget(p, 0, up(x0), x1);
    let b: u64 = lget(p, 1, x0, up(x1));
    let c: u64 = lget(p, 0, x0, x1);
    return f64_sub(f64_sub(a, b), c);
}

fn plaqB(mu: u32, x0: u32, x1: u32, p: ptr) -> u64 {
    if mu == 0 {
        let a: u64 = lget(p, 0, dn(x0), x1);
        let b: u64 = lget(p, 1, up(dn(x0)), dn(x1));
        let c: u64 = lget(p, 1, dn(x0), dn(x1));
        return f64_sub(f64_add(a, b), c);
    }
    let a: u64 = lget(p, 1, dn(x0), x1);
    let b: u64 = lget(p, 0, up(dn(x0)), x1);
    let c: u64 = lget(p, 0, dn(x0), x1);
    return f64_sub(f64_add(a, b), c);
}

fn accept(dS: u64, sp: ptr) -> bool {
    if f64_le(dS, ZERO) {
        return true;
    }
    let r: u64 = uniform01(sp);
    let pacc: u64 = mathf_exp(f64_neg(dS));
    return f64_lt(r, pacc);
}

fn update(p: ptr, sp: ptr, qp: ptr, mu: u32, x0: u32, x1: u32, beta: u64) -> bool {
    let old: u64 = lget(p, mu, x0, x1);
    let u: u64 = uniform01(sp);
    let d: u64 = f64_mul(DELTA, f64_sub(f64_add(u, u), ONE));
    let nw: u64 = wrap(f64_add(old, d));
    let A: u64 = plaqA(mu, x0, x1, p);
    let B: u64 = plaqB(mu, x0, x1, p);
    let t1: u64 = f64_sub(mathf_cos_scr(f64_add(old, A), qp), mathf_cos_scr(f64_add(nw, A), qp));
    let t2: u64 = f64_sub(mathf_cos_scr(f64_sub(B, old), qp), mathf_cos_scr(f64_sub(B, nw), qp));
    let dS: u64 = f64_mul(beta, f64_add(t1, t2));
    if accept(dS, sp) {
        lset(p, mu, x0, x1, nw);
        return true;
    }
    return false;
}

fn sweep(p: ptr, sp: ptr, qp: ptr, beta: u64) -> u32 {
    let acc: u32 = 0;
    let mu: u32 = 0;
    while mu < 2 {
        let x0: u32 = 0;
        while x0 < L {
            let x1: u32 = 0;
            while x1 < L {
                if update(p, sp, qp, mu, x0, x1, beta) {
                    acc = acc + 1;
                }
                x1 = x1 + 1;
            }
            x0 = x0 + 1;
        }
        mu = mu + 1;
    }
    return acc;
}

fn plaquette(p: ptr, qp: ptr) -> u64 {
    let s: u64 = ZERO;
    let x0: u32 = 0;
    while x0 < L {
        let x1: u32 = 0;
        while x1 < L {
            let t: u64 = lget(p, 0, x0, x1);
            t = f64_add(t, lget(p, 1, up(x0), x1));
            t = f64_sub(t, lget(p, 0, x0, up(x1)));
            t = f64_sub(t, lget(p, 1, x0, x1));
            s = f64_add(s, mathf_cos_scr(t, qp));
            x1 = x1 + 1;
        }
        x0 = x0 + 1;
    }
    return s;
}

fn wilson_sum(p: ptr, qp: ptr, R: u32, T: u32) -> u64 {
    let acc: u64 = ZERO;
    let x0: u32 = 0;
    while x0 < L {
        let x1: u32 = 0;
        while x1 < L {
            let s: u64 = ZERO;
            let i: u32 = 0;
            while i < R {
                s = f64_add(s, lget(p, 0, (x0 + i) % L, x1));
                i = i + 1;
            }
            i = 0;
            while i < T {
                s = f64_add(s, lget(p, 1, (x0 + R) % L, (x1 + i) % L));
                i = i + 1;
            }
            i = 0;
            while i < R {
                s = f64_sub(s, lget(p, 0, (x0 + R - 1 - i) % L, (x1 + T) % L));
                i = i + 1;
            }
            i = 0;
            while i < T {
                s = f64_sub(s, lget(p, 1, x0, (x1 + T - 1 - i) % L));
                i = i + 1;
            }
            acc = f64_add(acc, mathf_cos_scr(s, qp));
            x1 = x1 + 1;
        }
        x0 = x0 + 1;
    }
    return acc;
}

fn put_dec(buf: ptr, v: u64) {
    let n: u32 = 0;
    let x: u64 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + (x % 10)) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, 1, buf as u64, n as u64);
}

fn put_f64(out: ptr, sc: ptr, x: u64) {
    let n: u32 = f64fmt_fixed(out, 0, x, 6, sc);
    syscall4(1, 1, out as u64, n as u64);
}

fn main() {
    let rng: ptr = alloc(8);
    let qp: ptr = alloc(8);
    let out: ptr = alloc(64);
    let sc: ptr = alloc(f64fmt_scratch_bytes());
    mem_store64(rng, 0, rand_seed(1234));
    let theta: u64 = ZERO;
    let acc: u32 = 0;
    let sum: u64 = ZERO;
    let n: u32 = 0;
    let s: u32 = 0;
    let beta: u64 = 0x3FE0000000000000;
    while s < 200000 {
        let u: u64 = uniform01(rng);
        let d: u64 = f64_mul(DELTA, f64_sub(f64_add(u, u), ONE));
        let nw: u64 = wrap(f64_add(theta, d));
        let dS: u64 = f64_mul(beta, f64_sub(mathf_cos_scr(theta, qp), mathf_cos_scr(nw, qp)));
        if accept(dS, rng) {
            theta = nw;
            acc = acc + 1;
        }
        if s > 150000 {
            sum = f64_add(sum, mathf_cos_scr(theta, qp));
            n = n + 1;
        }
        s = s + 1;
    }
    print("mean cos=");
    put_f64(out, sc, f64_div(sum, f64conv_from_u64(n as u64)));
    print("\nacc=");
    put_f64(out, sc, f64_div(f64conv_from_u64(acc as u64), f64conv_from_u64(200000)));
    print("\n");
}
