module f64test
choose runtime

use "stdlib/f64.lomt"
use "stdlib/f64conv.lomt"
use "stdlib/mathf.lomt"
use "stdlib/rand.lomt"

fn write_dec(fd: u64, v: u64) {
    let buf: ptr = alloc(24);
    let n: u32 = 0;
    let x: u64 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + (x % 10)) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, fd, buf as u64, n as u64);
}

fn main() {
    let a: u64 = f64conv_from_u64(3);
    let b: u64 = f64conv_from_u64(4);
    let s: u64 = mathf_sqrt(f64_add(f64_mul(a, a), f64_mul(b, b)));
    write_dec(1, f64conv_to_u64(s));
    print("\n");
    let st: u64 = rand_seed(12345);
    write_dec(1, rand_next(st));
    print("\n");
}
