module diag

choose runtime

use "stdlib/f64.lomt"
use "stdlib/f64conv.lomt"
use "stdlib/mathf.lomt"

const ZERO: u64 = 0x0000000000000000;
const ONE: u64 = 0x3FF0000000000000;
const TWO: u64 = 0x4000000000000000;
const PI: u64 = 0x400921FB54442D18;
const PI2: u64 = 0x3FF921FB54442D18;
const TWO_PI: u64 = 0x401921FB54442D18;

fn write_dec(fd: u64, v: u64) {
    let buf: ptr = alloc(24);
    let n: u32 = 0;
    let x: u64 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + (x % 10)) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, fd, buf as u64, n as u64);
}

fn cos_f64(x: u64) -> u64 {
    let y: u64 = x;
    while f64_gt(y, PI) {
        y = f64_sub(y, TWO_PI);
    }
    while f64_lt(y, f64_neg(PI)) {
        y = f64_add(y, TWO_PI);
    }
    let neg: bool = false;
    if f64_gt(y, PI2) {
        y = f64_sub(PI, y);
        neg = true;
    }
    if f64_lt(y, f64_neg(PI2)) {
        y = f64_sub(f64_neg(PI), y);
        neg = true;
    }
    let y2: u64 = f64_mul(y, y);
    let sum: u64 = ONE;
    let term: u64 = ONE;
    let k: u32 = 1;
    while k <= 6 {
        let d: u64 = f64conv_from_u64((((2 * k - 1) * (2 * k)) as u64));
        term = f64_div(f64_mul(term, f64_neg(y2)), d);
        sum = f64_add(sum, term);
        k = k + 1;
    }
    if neg {
        return f64_neg(sum);
    }
    return sum;
}

fn main() {
    print("A\n");
    if f64_lt(ONE, TWO) {
        print("lt ok\n");
    }
    print("B\n");
    if f64_gt(TWO, ONE) {
        print("gt ok\n");
    }
    print("C\n");
    let q: u64 = f64_div(ONE, TWO);
    write_dec(1, f64conv_to_u64(f64_mul(q, f64conv_from_u64(4))));
    print("\n");
    print("D\n");
    let c0: u64 = cos_f64(ZERO);
    write_dec(1, f64conv_to_u64(f64_mul(c0, f64conv_from_u64(1000))));
    print("\n");
    print("E\n");
    let c1: u64 = cos_f64(f64conv_from_u64(1));
    write_dec(1, f64conv_to_u64(f64_mul(c1, f64conv_from_u64(1000))));
    print("\n");
    print("F\n");
    let cp: u64 = cos_f64(PI);
    write_dec(1, f64conv_to_u64(f64_mul(cp, f64conv_from_u64(1000))));
    print("\n");
    print("G\n");
}
