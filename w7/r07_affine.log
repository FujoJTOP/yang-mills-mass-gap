====================================================================================================
R07-AFFINE  (beta=2.5, theta=pi/2;  model S_W = beta[1 - c cos(rho/2) + t a w])
====================================================================================================

-- A1  structural identities (all should be 0) --
[A1a] r01's A  minus  a*w(ρ)            : 0
[A1b] r01's C  minus  B                 : 0
[A1c] d_aa[-cos(ρ/2)] - B/2             : (a**2*(-rho*cos(rho/2) + 2*sin(rho/2))/4 - rho**2*sin(rho/2)/2)/rho**3
[A1d] d_a[a*w(ρ)] - B   (=A' vs B)      : 0
  =>  {A,B,C,D} 的秩塌缩不是 a=0 现象: 恒有 A = a w,  C = B  (= d_a B ... 见 A1c)

-- A2  exact decomposition  H = K0 G + beta*Delta,  K0 = c/(2t) --
[A2a] H - K0 G - [ t D - (c^2/4t) A ]   : 0
[A2b] Delta = a*(-a**2*rho**2*t**2*sin(rho/2) - 6*a**2*rho*t**2*cos(rho/2) + 12*a**2*t**2*sin(rho/2) - c**2*rho**4*sin(rho/2) + 6*rho**3*t**2*cos(rho/2) - 12*rho**2*t**2*sin(rho/2))/(4*rho**5*t)
[A2c] Delta 小 a 展开: a*(-c**2*sin(rho/2)/(4*rho*t) + 3*t*cos(rho/2)/(2*rho**2) - 3*t*sin(rho/2)/rho**3) + O(a**3)

-- A3  trig-basis decomposition  f = P sin(ρ/2) + Q cos(ρ/2) + R --
  P_G = -a**2*t/rho**3 + a*c/(2*rho) + t/rho
  Q_G = a**2*t/(2*rho**2)    R_G = 0
  P_H = (12*a**3*t - a*rho**2*(a**2*t + 2*a*c + 12*t) + 2*c*rho**4)/(4*rho**5)
  Q_H = a*(-6*a**2*t + rho**2*(a*c + 6*t))/(4*rho**4)    R_H = 0
  Q_H/Q_G = -3*a/rho**2 + c/(2*t) + 3/a
  P_H/P_G = (6*a**3*t - a*rho**2*(a**2*t + 2*a*c + 12*t)/2 + c*rho**4)/(rho**2*(-2*a**2*t + rho**2*(a*c + 2*t)))
  (Q_H/Q_G) - (P_H/P_G)  simplified : (-a**4*t**2 + 6*a**3*c*t - a**2*c**2*rho**2 + 12*a**2*t**2 - 6*a*c*rho**2*t - 12*rho**2*t**2)/(2*a*t*(2*a**2*t - a*c*rho**2 - 2*rho**2*t))
  P_H - (Q_H/Q_G)*P_G    simplified : -a**3*t/(4*rho**3) + 3*a**2*c/(2*rho**3) - a*c**2/(4*rho*t) + 3*a*t/rho**3 - 3*c/(2*rho) - 3*t/(a*rho)
  K_s - K_c  numerator over common denom, series in a: -3/a - a*c**2/(4*t**2) + O(a**2)

-- A4  Wronskians (w.r.t. rho; same zero set as w.r.t. u=rho/2) --
  W1 = W(G,H)      = a*(-a**4*rho**4*t**2 + a**4*rho**3*t**2*sin(rho) + 12*a**4*rho**2*t**2*cos(rho) + 12*a**4*rho**2*t**2 - 48*a**4*rho*t**2*sin(rho) - 48*a**4*t**2*cos(rho) + 48*a**4*t**2 - 2*a**3*c*rho**4*t*cos(rho) + 8*a**3*c*rho**4*t + 18*a**3*c*rho**3*t*sin(rho) + 48*a**3*c*rho**2*t*cos(rho) - 48*a**3*c*rho**2*t - a**2*c**2*rho**6 - a**2*c**2*rho**5*sin(rho) - 4*a**2*c**2*rho**4*cos(rho) + 4*a**2*c**2*rho**4 - 4*a**2*rho**4*t**2*cos(rho) + 16*a**2*rho**4*t**2 + 36*a**2*rho**3*t**2*sin(rho) + 96*a**2*rho**2*t**2*cos(rho) - 96*a**2*rho**2*t**2 - 6*a*c*rho**6*t - 6*a*c*rho**5*t*sin(rho) - 24*a*c*rho**4*t*cos(rho) + 24*a*c*rho**4*t - 12*rho**6*t**2 - 12*rho**5*t**2*sin(rho) - 48*rho**4*t**2*cos(rho) + 48*rho**4*t**2)/(16*rho**9)
  W2 = W(G',H')    = a*(-a**4*rho**6*t**2 - a**4*rho**5*t**2*sin(rho) - 24*a**4*rho**4*t**2*cos(rho) + 24*a**4*rho**4*t**2 + 240*a**4*rho**3*t**2*sin(rho) + 1200*a**4*rho**2*t**2*cos(rho) + 240*a**4*rho**2*t**2 - 2880*a**4*rho*t**2*sin(rho) - 2880*a**4*t**2*cos(rho) + 2880*a**4*t**2 + 2*a**3*c*rho**6*t*cos(rho) + 12*a**3*c*rho**6*t - 38*a**3*c*rho**5*t*sin(rho) - 288*a**3*c*rho**4*t*cos(rho) - 192*a**3*c*rho**4*t + 960*a**3*c*rho**3*t*sin(rho) + 960*a**3*c*rho**2*t*cos(rho) - 960*a**3*c*rho**2*t - a**2*c**2*rho**8 + a**2*c**2*rho**7*sin(rho) + 12*a**2*c**2*rho**6*cos(rho) + 12*a**2*c**2*rho**6 - 48*a**2*c**2*rho**5*sin(rho) - 48*a**2*c**2*rho**4*cos(rho) + 48*a**2*c**2*rho**4 + 4*a**2*rho**6*t**2*cos(rho) + 24*a**2*rho**6*t**2 - 76*a**2*rho**5*t**2*sin(rho) - 576*a**2*rho**4*t**2*cos(rho) - 384*a**2*rho**4*t**2 + 1920*a**2*rho**3*t**2*sin(rho) + 1920*a**2*rho**2*t**2*cos(rho) - 1920*a**2*rho**2*t**2 - 6*a*c*rho**8*t + 6*a*c*rho**7*t*sin(rho) + 72*a*c*rho**6*t*cos(rho) + 72*a*c*rho**6*t - 288*a*c*rho**5*t*sin(rho) - 288*a*c*rho**4*t*cos(rho) + 288*a*c*rho**4*t - 12*rho**8*t**2 + 12*rho**7*t**2*sin(rho) + 144*rho**6*t**2*cos(rho) + 144*rho**6*t**2 - 576*rho**5*t**2*sin(rho) - 576*rho**4*t**2*cos(rho) + 576*rho**4*t**2)/(64*rho**11)
  W1 series in a (a->0): a*(-3*t**2/(4*rho**3) - 3*t**2*sin(rho)/(4*rho**4) - 3*t**2*cos(rho)/rho**5 + 3*t**2/rho**5) + O(a**2)
  W2 series in a (a->0): a*(-3*t**2/(16*rho**3) + 3*t**2*sin(rho)/(16*rho**4) + 9*t**2*cos(rho)/(4*rho**5) + 9*t**2/(4*rho**5) - 9*t**2*sin(rho)/rho**6 - 9*t**2*cos(rho)/rho**7 + 9*t**2/rho**7) + O(a**2)
  W{sin(ρ/2),cos(ρ/2),1} = -1/8 (nonzero => 1 is NOT in their span)
  a=0.0 rho=2.5:  W1=0.000000e+00+0.000000e+00j   W2=0.000000e+00+0.000000e+00j
  a=0.0 rho=4.0:  W1=0.000000e+00+0.000000e+00j   W2=0.000000e+00+0.000000e+00j
  a=0.3 rho=2.5:  W1=-7.206421e-04+0.000000e+00j   W2=-8.461580e-06+0.000000e+00j
  a=0.3 rho=4.0:  W1=-8.067746e-04+0.000000e+00j   W2=-2.629055e-05+0.000000e+00j
  a=1.2 rho=2.5:  W1=-4.156967e-03+0.000000e+00j   W2=-4.913544e-05+0.000000e+00j
  a=1.2 rho=4.0:  W1=-4.651098e-03+0.000000e+00j   W2=-1.526051e-04+0.000000e+00j

-- A5  u-form (u=rho/2, g=sin(u)/u):  A = a*sin(u)/(2u) = (a/2) g(u) --
  A  in u : a*sin(U)/(2*U)
  B  in u : (4*U**2*sin(U) + a**2*(U*cos(U) - sin(U)))/(8*U**3)
  Co in u : (4*U**2*sin(U) + U*a**2*cos(U) - a**2*sin(U))/(8*U**3)
  D  in u : a*(12*U**2*(U*cos(U) - sin(U)) + a**2*(-U**2*sin(U) - 3*U*cos(U) + 3*sin(U)))/(32*U**5)
  G  in u : (2*U**2*a*c*sin(U) + t*(4*U**2*sin(U) + a**2*(U*cos(U) - sin(U))))/(8*U**3)
  H  in u : (2*U**2*c*(4*U**2*sin(U) + U*a**2*cos(U) - a**2*sin(U)) - a*t*(-12*U**2*(U*cos(U) - sin(U)) + a**2*(U**2*sin(U) + 3*U*cos(U) - 3*sin(U))))/(32*U**5)
  G(u)|a=0 : t*sin(U)/(2*U)    [= c/2 * sin(u)/(2u)]
  H(u)|a=0 : c*sin(U)/(4*U)    [= (c/2) * sin(u)/(2u)]

