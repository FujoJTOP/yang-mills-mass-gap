\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces The $k\to 0$ curvature probe on a single $L=8$ volume ($\mathrm  {SU}(3)$, $\beta =5.7$), with an $\mathrm  {SU}(3)$ $L=4$ check; all plotted points are $\mathrm  {SU}(3)$, while $\mathrm  {SU}(2)$ ($\beta =2.4$) reproduces the sign without being plotted. The measured points are positive and volume-stable, and $W_{\mathrm  {geo}}$ is pinned at $+0.32$. This is a $k\to 0$ sign probe on a gauge-dependent gluon mode in a flat chart, \emph  {not} the gauge-invariant $0^{++}$ residue; keeping only the proven $W_{\mathrm  {geo}}\ge 0$ and treating the rest statistically gives $95\%$ one-sided lower bounds of $-0.098$ ($\mathrm  {SU}(3)$) and $-0.035$ ($\mathrm  {SU}(2)$), so zero is not excluded. Label \fcolorbox {cE!35}{cE!8}{\textcolor {cE}{\textbf  {\scriptsize  E}}}.}}{61}{figure.caption.24}\protected@file@percent }
\newlabel{fig:probe}{{13}{61}{The $k\to 0$ curvature probe on a single $L=8$ volume ($\mathrm {SU}(3)$, $\beta =5.7$), with an $\mathrm {SU}(3)$ $L=4$ check; all plotted points are $\mathrm {SU}(3)$, while $\mathrm {SU}(2)$ ($\beta =2.4$) reproduces the sign without being plotted. The measured points are positive and volume-stable, and $W_{\mathrm {geo}}$ is pinned at $+0.32$. This is a $k\to 0$ sign probe on a gauge-dependent gluon mode in a flat chart, \emph {not} the gauge-invariant $0^{++}$ residue; keeping only the proven $W_{\mathrm {geo}}\ge 0$ and treating the rest statistically gives $95\%$ one-sided lower bounds of $-0.098$ ($\mathrm {SU}(3)$) and $-0.035$ ($\mathrm {SU}(2)$), so zero is not excluded. Label \LE }{figure.caption.24}{}}
