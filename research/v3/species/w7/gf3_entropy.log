[K] interface-slope cost: transition d carries weight y^|d| (y<1 suppresses)
    mu(y) <= e  <=>  y <= y*   ;  cost per unit slope kappa* = -ln y*
    s=1 : mu(1)<=e ? False ; mu(1/16)<=e ? True
    s=1 : y* in [0.8449303210, 0.8449305445]  =>  kappa* = -ln y* in [0.168501, 0.168501]
    s=2 : mu(1)<=e ? False ; mu(1/16)<=e ? True
    s=2 : y* in [0.6695958823, 0.6695961058]  =>  kappa* = -ln y* in [0.401081, 0.401081]
    s=3 : mu(1)<=e ? False ; mu(1/16)<=e ? True
    s=3 : y* in [0.6424192935, 0.6424195170]  =>  kappa* = -ln y* in [0.442514, 0.442514]

[M] closed form check (one-sided family): P_s == (1-x)^s * (1-2x-x^2-...-x^{s+1})
    s=0 P=[1, -2]
        (1-x)^0*(1-2x-...-x^1)=[1, -2]  OK
    s=1 P=[1, -3, 1, 1]
        (1-x)^1*(1-2x-...-x^2)=[1, -3, 1, 1]  OK
    s=2 P=[1, -4, 4, -1, 1, -1]
        (1-x)^2*(1-2x-...-x^3)=[1, -4, 4, -1, 1, -1]  OK
    s=3 P=[1, -5, 8, -5, 1, 1, -2, 1]
        (1-x)^3*(1-2x-...-x^4)=[1, -5, 8, -5, 1, 1, -2, 1]  OK
    s=4 P=[1, -6, 13, -13, 6, -1, 1, -3, 3, -1]
        (1-x)^4*(1-2x-...-x^5)=[1, -6, 13, -13, 6, -1, 1, -3, 3, -1]  OK
    s=5 P=[1, -7, 19, -26, 19, -7, 1, 1, -4, 6, -4, 1]
        (1-x)^5*(1-2x-...-x^6)=[1, -7, 19, -26, 19, -7, 1, 1, -4, 6, -4, 1]  OK
    s=6 P=[1, -8, 26, -45, 45, -26, 8, -1, 1, -5, 10, -10, 5, -1]
        (1-x)^6*(1-2x-...-x^7)=[1, -8, 26, -45, 45, -26, 8, -1, 1, -5, 10, -10, 5, -1]  OK
    s=0..6 all PASS ; hence x_s solves x+x^2+...+x^{s+1}=1-x and mu(D_s)=1/x_s

