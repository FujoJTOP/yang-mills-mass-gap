    a=1.0: Phi = 171.503;  term peak at |r|=4;  t(400)/t(399) = 0.00852  (<1 => converged);  partials S(|r|<=2) = 36.34
    a=2.0: Phi = 120567;  term peak at |r|=10;  t(400)/t(399) = 0.0231  (<1 => converged);  partials S(|r|<=2) = 216.66
