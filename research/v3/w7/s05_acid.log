   omega=1.00   G''_a = 2*omega =  2.000   ;  m_L = min(omega, 2pi^2/L^2) -> 0
   omega=2.00   G''_a = 2*omega =  4.000   ;  m_L = min(omega, 2pi^2/L^2) -> 0
   b-sector: Lebesgue (S=0, Phi=0, J=1) => Delta_dyn=0, W=0 => G''_b = 0  EXACT
   => pointwise-in-a-mode reading: (star) TRUE on M6 ; inf-over-sectors reading: 0 -> FALSE

