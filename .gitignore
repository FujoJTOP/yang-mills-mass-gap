# ---- Vendored third-party (11G: OSforGFF, FujoOS, YM-audit, Loment) ----
vendor/

# ---- Raw simulation data: numpy run outputs (~855M) — not source ----
*.npz

# ---- Build artifacts / compiled binaries ----
*.exe
*.olean
*.ilean
*.so
*.dll
.lake/
.lake-packages/
__pycache__/
*.pyc
node_modules/

# ---- Local agent/tool state (local settings; not source) ----
.claude/
.tools/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Numba / compilation caches ----
*.nbc
nbcache/

# LaTeX build artifacts (paper-v2)
docs/paper-v2/*.aux
docs/paper-v2/*.log
docs/paper-v2/*.toc
docs/paper-v2/*.out
docs/paper-v2/out*.txt

# LaTeX build artifacts (paper-v3)
docs/paper-v3/*.aux
docs/paper-v3/*.log
docs/paper-v3/*.toc
docs/paper-v3/*.out
